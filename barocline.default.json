    "model": {
        "class": "Model",

        "dynamicsCore": {
            "class": "BaroclinicHydrostaticCore",
            "dampingCoef": 0.025,
            "dampingOrder": 4,
            "diffusionCoef": 0.0125,
            "diffusionOrder": 4
        },

        "name": "PIFO",

        "projection": {
            "ref": "modelDomain"
        },

        "timeIntegrator" : {
            "class": "LeapFrogTimeIntegrator"
        },
        
        "timeFilter" : {
            "class": "RobertAsselinTimeFilter",
            "epsilon": 0.428
        },

        "width": {"ref": "modelDomain", "property" : "width"},
        "height": {"ref": "modelDomain", "property" : "height"},
        "horizontalStaggering": "C",
        "global": false,
        "filterInterval": 1,
        "verticalStaggering":  "L",
          
        "verticalCoords" : {"ref":"sigmaLayers", "property":"sigmaLevels"},
       
        "boundaryCondition": {
            "class": "CouplingLimitedAreaBoundaryCondition",
            "relaxation": 8
        },
        
        "COMMENTED_OUT___physicsSchemes": [
            {
                "class": "PrecipitationScheme"
            }
        ],

        "dt": 15
    },
    
    "scenario": {
        "preprocessor" : {
            "class": "DataProcessor",
            
            "processList": [
                { "name":"Z", "task" : "z_interpolation", "parameters": [{"name":"source", "value":"prmsl"}, {"name":"variable", "value": "Z"} ]},
                { "name":"U", "task" : "wind_interpolation", "parameters": [{"name":"source", "value":"ugrd"}, {"name":"component_source", "value":"vgrd"}, {"name": "variable", "value":"U"}]},
