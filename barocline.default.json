                        {"outputComponent":"pressure_source", "output":"main", "inputComponent":"projection_component2", "input":"main"},
                        {"outputComponent":"tmp_source", "output":"main", "inputComponent":"projection_component3", "input":"main"},
                        
                        {"outputComponent":"projection_component", "output":"main", "inputComponent":"vertical_component", "input":"main"},
